---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** HTML element. */
  tag?: "span" | "p" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Eyebrow style. */
  variant?: "default" | "tag";
};

const {
  render = true,
  tag: Tag = "p",
  variant = "default",
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{render && content && (
  <div
    class:list={["eyebrow_wrap", variant !== "default" && variant, className]}
    {...rest}
  >
    {variant === "default" && (
      <span class="eyebrow_marker" aria-hidden="true">//</span>
    )}
    <Tag class="eyebrow_text text-style-small">
      <Fragment set:html={content} />
    </Tag>
  </div>
)}

<style is:global>
  @layer components {
    .eyebrow_wrap {
      font-family: var(--mono-family);
      color: var(--heading-accent);
      display: inline-flex;
      align-items: center;
      justify-content: var(--_alignment, start);
      gap: var(--space-2);

      &.tag {
        background-color: color-mix(
          in srgb,
          var(--heading-accent) 10%,
          var(--background)
        );
        color: var(--heading-accent);
        border: var(--border-width) solid
          color-mix(in srgb, var(--heading-accent) 40%, var(--background));
        padding: var(--space-1) var(--space-2);
        border-radius: var(--radius-small);
      }
      &:not(.tag) .eyebrow_text {
        color: var(--text);
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .eyebrow_text {
        font-family: var(--mono-family);
      }
      .eyebrow_marker {
        flex: none;
        font-size: 0.75rem;
        letter-spacing: -0.1em;
      }
    }
  }
</style>
