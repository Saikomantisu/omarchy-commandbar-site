---
import BaseHead from "@/components/utility/BaseHead.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import "@/styles/global.css";
---

<!doctype html>
<html lang="en" class="theme-dark">
  <head><BaseHead title="Lumos for Astro" /></head>
  <body>
    <main id="main">
      <Section>
        <ContentWrapper>
          <Heading tag="h1">Lumos for Astro</Heading>
          <Paragraph>Astro components, plain CSS and custom properties.</Paragraph>
        </ContentWrapper>
      </Section>
    </main>
  </body>
</html>
